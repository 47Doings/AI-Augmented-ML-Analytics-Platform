
# --- PostgreSQL (matches the local Docker container from Step 1) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=postgres

# --- App security ---
# Used later to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Set to true when served over HTTPS. Leave false for http://localhost.
COOKIE_SECURE=false
# How long a login stays valid, in hours.
SESSION_HOURS=12

# --- Snwolley Agent API Toolkit ---
# Paste the key from the assignment brief here (testing key). NEVER commit it or put it in code.
# Without a key the app still works and shows a clearly labelled template summary.
SNWOLLEY_API_KEY=
# Optional. Defaults to the endpoint in the brief; only set it to override.
# SNWOLLEY_BASE_URL=https://v1.snwolley.ai/v1/chat/completions/assignment

# --- Logging ---
LOG_LEVEL=INFO
