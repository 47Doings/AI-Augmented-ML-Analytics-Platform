# Copy this file to .env and fill in the values.
#   PowerShell:  Copy-Item .env.example .env
# .env is git-ignored. NEVER commit real values or put them in the code.

# --- PostgreSQL (matches the local Docker container from Step 1) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=postgres

# --- App security ---
# Used later to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Set to true when served over HTTPS. Leave false for http://localhost.
COOKIE_SECURE=false
# How long a login stays valid, in hours.
SESSION_HOURS=12

# --- Snwolley Agent API Toolkit ---
# PLACEHOLDERS. Leave blank until Npontu sends the docs and API key.
# The variable names here are ours, not Snwolley's; they will be
# adjusted to match the real toolkit once we have its documentation.
SNWOLLEY_API_KEY=
SNWOLLEY_BASE_URL=

# --- Logging ---
LOG_LEVEL=INFO
